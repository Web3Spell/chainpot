# "base" = Base mainnet. Unset = Base Sepolia testnet.
PONDER_CHAIN=
# RPCs with full log history (e.g. Coinbase CDP Node). Only the one for PONDER_CHAIN is used.
PONDER_RPC_URL_8453=

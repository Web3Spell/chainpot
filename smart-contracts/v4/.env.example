# ChainPot V4 — contract deployment environment
#
# HOW TO USE
#   Mainnet:  cp .env.example .env.mainnet   → fill in the blanks → deploy with:
#               set -a && source .env.mainnet && set +a
#               forge script script/DeployV4.s.sol:DeployV4 --rpc-url "$RPC_URL"                        # dry run
#               forge script script/DeployV4.s.sol:DeployV4 --rpc-url "$RPC_URL" --broadcast --slow      # real
#   Testnet:  keep using .env (Base Sepolia values).
#
# SECRETS
#   - .env and .env.* are gitignored; only this .env.example is committed. Never commit a filled file.
#   - Never paste a private key into chat, Discord, screenshots or a ticket.
#   - Delete PRIVATE_KEY from .env.mainnet after the deploy and ownership handover are done.
#
# NOTE: the deploy script's variable names end in _BASE_SEPOLIA for historical reasons. They are plain
# addresses, so the mainnet values below go in the same variables. No contract code changes.

# ---------------------------------------------------------------- secrets (fill in)

# Deployer EOA private key (0x + 64 hex). A NEW wallet used only for this deploy.
# NOT a Safe signer, NOT the keeper, NOT the old testnet key. Fund with ~0.003 ETH on Base.
PRIVATE_KEY=

# Paid Base mainnet RPC (Coinbase CDP Node / Alchemy). Public fallback: https://mainnet.base.org
RPC_URL=https://mainnet.base.org

# Optional: Etherscan v2 API key (works for Basescan) to verify sources. Sourcify needs no key.
BASESCAN_API_KEY=

# ---------------------------------------------------------------- Base mainnet (chain 8453) — verified on-chain

# Native USDC on Base
USDC_BASE_SEPOLIA=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Compound III cUSDCv3 on Base (baseToken() = USDC)
COMET_USDC_BASE_SEPOLIA=0xb125E6687d4313864e53df431d5425969c15Eb2F
# Chainlink VRF v2.5 coordinator on Base
VRF_COORDINATOR_BASE_SEPOLIA=0xd5D517aBE5cF79B7e95eC98dB0f0277788aFF634
# VRF gas lane: 2 gwei max (cheapest registered lane on Base)
VRF_KEYHASH_BASE_SEPOLIA=0x00b81b5a830cb0a4009fbd8904de511e28631e62ce5ad231373d3cdad373ccab
# ChainPot's VRF subscription (vrf.chain.link → Base). Add VRFProviderV4 as consumer after deploy.
VRF_SUBSCRIPTION_ID=100306411118676076108123111759480455216400448433251835096864213055916970221410

# Receives the 20% interest share (Safety Module). MUST be the Safe, otherwise it defaults to the deployer.
TREASURY=0x7cc4C4833A53A2e66C21647A23F814Fd8ecB6b68

# Owner of every contract after the handover (2-of-3 Safe on Base). Used by the handover commands in
# docs/MAINNET_LAUNCH.md; the deploy script itself doesn't read it.
SAFE_ADDRESS=0x7cc4C4833A53A2e66C21647A23F814Fd8ecB6b68

# ---------------------------------------------------------------- Base Sepolia (testnet) reference
# USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# COMET_USDC_BASE_SEPOLIA=0x571621Ce60Cebb0c1D442B5afb38B1663C6Bf017
# VRF_COORDINATOR_BASE_SEPOLIA=0x5C210eF41CD1a72de73bF76eC39637bB0d3d7BEE
# VRF_KEYHASH_BASE_SEPOLIA=0x9e1344a1247c8a1785d0a4681a27152bffdb43666ae5bf7d14d24a5efd44bf71

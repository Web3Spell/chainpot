# ChainPot web app environment. Local: copy to .env.local (gitignored). Production: Vercel → Settings →
# Environment Variables. Never commit a filled file.
#
# RULE: anything starting with NEXT_PUBLIC_ is shipped to every visitor's browser. Only public values
# (app IDs, public API keys, RPC URLs) may use it. Secrets (DATABASE_URL, CRON_SECRET, RESEND_API_KEY,
# TWILIO_*, AUTOPAY_*, PRIVY_VERIFICATION_KEY) must NEVER have the NEXT_PUBLIC_ prefix.
#
# The web app holds no private keys. The deployer key lives only in smart-contracts/v4/.env.mainnet
# (deleted after deploy) and the keeper key only in the keeper's host.

# ---- Network ----
# "base" = Base mainnet (real USDC). Unset or "base-sepolia" = testnet. Picks chain, contract addresses,
# USDC, explorer links and RPC defaults (config/network.ts). Use the same value for the keeper (CHAIN).
NEXT_PUBLIC_CHAIN=
# Browser RPC for that network (CDP Node / Alchemy). Falls back to the public endpoint.
NEXT_PUBLIC_RPC_URL=
# Server-side RPC for API routes (can be a private keyed URL). Falls back to NEXT_PUBLIC_RPC_URL.
RPC_URL=
# Guarded-launch caps (mainnet defaults: 10 members, $100 per round; testnet: uncapped).
NEXT_PUBLIC_BETA_MAX_MEMBERS=
NEXT_PUBLIC_BETA_MAX_USD=

# WalletConnect / Reown project ID (https://cloud.reown.com)
NEXT_PUBLIC_WC_PROJECT_ID=
# Legacy testnet-only RPC names (still read when NEXT_PUBLIC_CHAIN is testnet).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Ponder indexer API (indexer/). Unset = the app reads directly from contracts.
NEXT_PUBLIC_INDEXER_URL=
# Supabase Postgres connection string (pooler URL). Unset in dev = in-memory invite store.
DATABASE_URL=
# Privy app ID (dashboard.privy.io). Set it to switch from "connect your wallet" to phone/email/social/
# passkey sign-in with a sponsored smart wallet. Unset = RainbowKit own-wallet mode.
NEXT_PUBLIC_PRIVY_APP_ID=
# Set to "false" if no paymaster is configured in the Privy dashboard (the UI then won't promise free gas).
NEXT_PUBLIC_GAS_SPONSORED=
# ---- Phase 3: profiles + reminders (server only) ----
# Privy app ID for the server (defaults to NEXT_PUBLIC_PRIVY_APP_ID) and, optionally, the verification
# key (SPKI PEM from the Privy dashboard). Without the key, Privy's public JWKS is used.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders.
CRON_SECRET=
APP_URL=
RESEND_API_KEY=
REMINDER_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# ---- Autopay (Kernel session keys) ----
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts stored session keys; use a KMS in production.
AUTOPAY_KEY_ENCRYPTION_KEY=
# ERC-4337 bundler + ERC-7677 paymaster (Coinbase CDP) for the SAME network as NEXT_PUBLIC_CHAIN.
# Mainnet: the CDP "Base mainnet" endpoint (one URL serves both).
AUTOPAY_BUNDLER_URL=
AUTOPAY_PAYMASTER_URL=
# ---- Phase 5 ----
# Enforce the Content-Security-Policy (otherwise Report-Only). Turn on after testing with real Privy flows.
CSP_ENFORCE=
# ---- Phase 4: fiat on-ramp (Transak) ----
# Buy USDC with card/bank/UPI. Unset = the balance card shows "copy my address" + the testnet faucet.
NEXT_PUBLIC_TRANSAK_API_KEY=
# STAGING (default) or PRODUCTION.
NEXT_PUBLIC_TRANSAK_ENV=
# On-ramp destination network. "base" (mainnet) delivers funds; leave as-is. On-ramps don't settle on testnets.
NEXT_PUBLIC_ONRAMP_NETWORK=

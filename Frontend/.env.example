# WalletConnect / Reown project ID (https://cloud.reown.com)
NEXT_PUBLIC_WC_PROJECT_ID=
# Dedicated Base Sepolia RPC (e.g. Coinbase CDP Node). Falls back to a public endpoint.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Server-side RPC for API routes (falls back to the public one above).
BASE_SEPOLIA_RPC_URL=
# Ponder indexer API (indexer/). Unset = the app reads directly from contracts.
NEXT_PUBLIC_INDEXER_URL=
# Supabase Postgres connection string (pooler URL). Unset in dev = in-memory invite store.
DATABASE_URL=
# Privy app ID (dashboard.privy.io). Set it to switch from "connect your wallet" to phone/email/social/
# passkey sign-in with a sponsored smart wallet. Unset = RainbowKit own-wallet mode.
NEXT_PUBLIC_PRIVY_APP_ID=
# Set to "false" if no paymaster is configured in the Privy dashboard (the UI then won't promise free gas).
NEXT_PUBLIC_GAS_SPONSORED=

# ChainPot keeper — moves circles along (start rounds, settle, draw, finalize, push payouts).
# Copy to .env (or set these in your host's dashboard: Railway, Fly, Render…). .env* is gitignored.
#
# KEEPER_PRIVATE_KEY is a hot key that lives on a server 24/7:
#   - use a NEW wallet made only for the keeper (`cast wallet new`);
#   - it must NOT be a Safe signer, the deployer, or any wallet that holds real money;
#   - fund it with gas only: ~0.002 ETH on Base. It never needs USDC or LINK;
#   - it has no special rights in the contracts. Every keeper call is permissionless, so a leaked key
#     can at worst lose its gas money.

# Defaults to dry run (logs only). Set DRY_RUN=false once KEEPER_PRIVATE_KEY is set to actually send.
DRY_RUN=true
# 0x + 64 hex. Keeper wallet private key (see above).
KEEPER_PRIVATE_KEY=
# Paid Base RPC. Mainnet: CDP Node / Alchemy (https://mainnet.base.org works but is rate-limited).
# Testnet: a Base Sepolia RPC.
KEEPER_RPC_URL=
INTERVAL_SEC=60
# Don't push balances below this (USDC base units; 1000000 = $1).
CLAIM_MIN_USDC_UNITS=1000000
# Comma-separated addresses that prefer to claim themselves.
CLAIM_OPT_OUT=
# Never pay more than this per gas unit (Base is usually ~0.01 gwei).
MAX_FEE_GWEI=1
# Optional: also call the app's cron routes (reminders + autopay) every CRON_EVERY_SEC.
# Needed on Vercel Hobby, which only allows daily crons (vercel.json runs them once a day as a backstop).
# APP_URL = the site (https://chainpot.fun). CRON_SECRET = the same value as CRON_SECRET in Vercel.
APP_URL=
CRON_SECRET=
CRON_EVERY_SEC=900
